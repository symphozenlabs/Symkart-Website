# Server-only configuration. Copy to .env locally; never commit real secrets.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/symkart?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5173

# Public values are safe to expose to the browser.
PUBLIC_APP_NAME=SYMKART
PUBLIC_APP_URL=http://localhost:5173
